@@ -0,0 +1,46 @@
+import VideoChapterMenu from '#lib/components/asset-viewer/VideoChapterMenu.svelte';
+import 'hls-video-element';
+import { render } from 'vitest-browser-svelte';
+import { page } from 'vitest/browser';
+
+const chapters = [
+  { startTime: 0, endTime: 1.25, title: 'Intro' },
+  { startTime: 1.25, endTime: 3, title: 'Snow = 雪' },
+  { startTime: 3, endTime: 4, title: null },
+];
+
+describe('VideoChapterMenu', () => {
+  it.each(['video', 'hls-video'])('seeks %s playback to a chapter without replacing the source', async (tag) => {
+    const player = document.createElement(tag) as HTMLVideoElement;
+    await render(VideoChapterMenu, { chapters, player, ready: true, currentTime: 0 });
+    await page.getByTitle('video_chapters', { exact: true }).click();
+    await page.getByRole('button', { name: '0:01 Snow = 雪' }).click();
+    expect(player.currentTime).toBe(1.25);
+    expect(player.getAttribute('src')).toBeNull();
+    await expect.element(page.getByTitle('video_chapters', { exact: true })).toHaveFocus();
+  });
+
+  it('hides chapter controls when no chapters exist', async () => {
+    await render(VideoChapterMenu, { chapters: [], player: undefined, ready: false, currentTime: 0 });
+    await expect.element(page.getByTitle('video_chapters', { exact: true })).not.toBeInTheDocument();
+  });
+
+  it('disables seeking until media metadata is loaded', async () => {
+    await render(VideoChapterMenu, { chapters, player: undefined, ready: false, currentTime: 0 });
+    await page.getByTitle('video_chapters', { exact: true }).click();
+    await expect.element(page.getByRole('button', { name: '0:00 Intro' })).toBeDisabled();
+  });
+
+  it('marks the current chapter, provides missing titles and renders embedded markup as text', async () => {
+    const { baseElement } = await render(VideoChapterMenu, {
+      chapters: [...chapters, { startTime: 4, endTime: 5, title: '<img src=x onerror=alert(1)>' }],
+      player: undefined,
+      ready: true,
+      currentTime: 1.5,
+    });
+    await page.getByTitle('video_chapters', { exact: true }).click();
+    await expect.element(page.getByRole('button', { name: '0:01 Snow = 雪' })).toHaveAttribute('aria-current', 'true');
+    await expect.element(page.getByRole('button', { name: /0:03 video_chapter/ })).toBeVisible();
+    expect(baseElement.querySelector('img')).toBeNull();
+  });
+});
diff --git a/web/src/lib/components/asset-viewer/VideoChapterMenu.svelte b/web/src/lib/components/asset-viewer/VideoChapterMenu.svelte
new file mode 100644
index 000000000..27be749cc
--- /dev/null
+++ b/web/src/lib/components/asset-viewer/VideoChapterMenu.svelte
@@ -0,0 +1,66 @@
+<script lang="ts">
+  import type { AssetChapterResponseDto } from '@immich/sdk';
+  import { Icon } from '@immich/ui';
+  import { mdiFormatListNumbered } from '@mdi/js';
+  import { Duration } from 'luxon';
+  import { t } from 'svelte-i18n';
+
+  interface Props {
+    chapters: AssetChapterResponseDto[];
+    player: Pick<HTMLMediaElement, 'currentTime'> | undefined;
+    ready: boolean;
+    currentTime: number;
+  }
+
+  let { chapters, player, ready, currentTime }: Props = $props();
+  let menu: HTMLDetailsElement | undefined = $state();
+  const activeIndex = $derived(
+    chapters.findLastIndex((chapter) => currentTime >= chapter.startTime && currentTime < chapter.endTime),
+  );
+
+  const seek = (startTime: number) => {
+    if (player && ready) {
+      player.currentTime = startTime;
+      if (menu) {
+        menu.open = false;
+        menu.querySelector('summary')?.focus();
+      }
+    }
+  };
+
+  const timestamp = (seconds: number) =>
+    Duration.fromObject({ seconds: Math.floor(seconds) }).toFormat(seconds >= 3600 ? 'h:mm:ss' : 'm:ss');
+</script>
+
+{#if chapters.length > 0}
+  <details bind:this={menu} class="relative shrink-0">
+    <summary
+      class="cursor-pointer list-none rounded-full p-2"
+      aria-label={$t('video_chapters')}
+      title={$t('video_chapters')}
+    >
+      <Icon icon={mdiFormatListNumbered} />
+    </summary>
+    <ol
+      aria-label={$t('video_chapters')}
+      class="absolute right-0 bottom-12 z-10 max-h-64 w-72 max-w-[80vw] overflow-y-auto rounded-xl bg-light-100 p-2 leading-normal text-dark shadow-sm"
+    >
+      {#each chapters as chapter, index (chapter.startTime)}
+        <li>
+          <button
+            type="button"
+            class="flex min-h-10 w-full gap-3 rounded-lg p-2 text-left hover:bg-light-200 focus-visible:bg-light-200 aria-current:bg-light-200"
+            disabled={!ready}
+            aria-current={index === activeIndex ? 'true' : undefined}
+            onclick={() => seek(chapter.startTime)}
+          >
+            <span class="shrink-0 tabular-nums">{timestamp(chapter.startTime)}</span>
+            <span class="min-w-0 wrap-anywhere"
+              >{chapter.title || $t('video_chapter', { values: { number: index + 1 } })}</span
+            >
+          </button>
+        </li>
+      {/each}
+    </ol>
+  </details>
+{/if}
