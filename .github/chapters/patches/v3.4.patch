+import { extractChapters } from 'src/utils/chapters.js';
+
+describe('extractChapters', () => {
+  it.each([undefined, null, {}, 'chapters'])('ignores invalid chapter collections: %s', (input) => {
+    expect(extractChapters(input, 10)).toEqual([]);
+  });
+
+  it('sorts chapters, limits them to the video duration and preserves titles', () => {
+    expect(
+      extractChapters(
+        [
+          { start_time: '5.125', end_time: '12', 'TAG:title': String.raw`雪 = \nHello\\World` },
+          { start_time: 0, end_time: 5.125, 'TAG:title': '  Intro  ' },
+        ],
+        10,
+      ),
+    ).toEqual([
+      { startTime: 0, endTime: 5.125, title: 'Intro' },
+      { startTime: 5.125, endTime: 10, title: '雪 = \nHello\\World' },
+    ]);
+  });
+
+  it('preserves valid chapters without titles or a known duration', () => {
+    expect(extractChapters([{ start_time: '1', end_time: '2' }], 0)).toEqual([
+      { startTime: 1, endTime: 2, title: null },
+    ]);
+    expect(extractChapters([{ start_time: 1, end_time: 2, 'TAG:title': 42 }], NaN)).toEqual([
+      { startTime: 1, endTime: 2, title: null },
+    ]);
+  });
+
+  it('ignores malformed chapters and duplicate starts without losing valid entries', () => {
+    expect(
+      extractChapters(
+        [
+          null,
+          {},
+          { start_time: '', end_time: 1 },
+          { start_time: null, end_time: 1 },
+          { start_time: 'N/A', end_time: 1 },
+          { start_time: -1, end_time: 1 },
+          { start_time: 1, end_time: Infinity },
+          { start_time: 2, end_time: 1 },
+          { start_time: 1, end_time: 1 },
+          { start_time: 10, end_time: 11 },
+          { start_time: 0, end_time: 1, 'TAG:title': ' '.repeat(3) },
+          { start_time: 0, end_time: 2, 'TAG:title': 'Duplicate' },
+        ],
+        10,
+      ),
+    ).toEqual([{ startTime: 0, endTime: 1, title: null }]);
+  });
+});
diff --git a/server/src/utils/chapters.ts b/server/src/utils/chapters.ts
new file mode 100644
index 000000000..871248518
--- /dev/null
+++ b/server/src/utils/chapters.ts
@@ -0,0 +1,49 @@
+import z from 'zod';
+import { AssetChapterResponseDto, AssetChapterSchema } from 'src/dtos/asset-chapters.dto.js';
+
+const timestamp = z
+  .union([z.number(), z.string().trim().min(1)])
+  .transform(Number)
+  .pipe(z.number().nonnegative());
+const ProbeChapterSchema = z.object({
+  start_time: timestamp,
+  end_time: timestamp,
+  'TAG:title': z.unknown().optional(),
+});
+
+export const extractChapters = (input: unknown, duration: number): AssetChapterResponseDto[] => {
+  if (!Array.isArray(input)) {
+    return [];
+  }
+
+  const chapters: AssetChapterResponseDto[] = [];
+  for (const item of input) {
+    const result = ProbeChapterSchema.safeParse(item);
+    if (!result.success) {
+      continue;
+    }
+
+    const { start_time: startTime, end_time: endTime, 'TAG:title': rawTitle } = result.data;
+    const title =
+      typeof rawTitle === 'string'
+        ? rawTitle
+            .replaceAll(
+              /\\([\\nrtbf])/g,
+              (_, char: string) => ({ n: '\n', r: '\r', t: '\t', b: '\b', f: '\f' })[char] ?? char,
+            )
+            .trim()
+        : '';
+    const chapter = AssetChapterSchema.safeParse({
+      startTime,
+      endTime: Number.isFinite(duration) && duration > 0 ? Math.min(endTime, duration) : endTime,
+      title: title || null,
+    });
+    if (chapter.success) {
+      chapters.push(chapter.data);
+    }
+  }
+
+  return chapters
+    .sort((a, b) => a.startTime - b.startTime)
+    .filter((chapter, index, sorted) => index === 0 || chapter.startTime !== sorted[index - 1].startTime);
+};
